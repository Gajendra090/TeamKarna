  "edges": [
    {
      "from": "wf_open_app",
      "to": "wf_google_login",
      "label": "Optional OAuth",
      "role": "branch"
    },
    {
      "from": "wf_open_app",
      "to": "wf_select_intake",
      "label": "Go to Dashboard",
      "role": "main"
    },
    {
      "from": "wf_google_login",
      "to": "wf_validate_extract",
      "label": "User dir ready",
      "role": "branch"
    },
    {
      "from": "wf_select_intake",
      "to": "wf_validate_extract",
      "label": "Submit files",
      "role": "main"
    },
    {
      "from": "wf_validate_extract",
