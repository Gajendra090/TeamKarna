  "semanticChecks": {
    "allowedRoots": [
      "wf_open_app"
    ],
    "allowedTerminals": [
      "wf_save_history"
    ],
    "requiredEdges": [
      {
        "from": "wf_open_app",
        "to": "wf_select_intake"
      },
      {
        "from": "wf_select_intake",
        "to": "wf_validate_extract"
      },
      {
        "from": "wf_validate_extract",
        "to": "wf_run_pipeline"
      },
      {
        "from": "wf_run_pipeline",
        "to": "wf_explore_insights"
      }
    ]
  },
  "cards": [
    {
      "dot": "cyan",
      "title": "Flexible Entry Without Hard Login Gate",
      "items": [
        "Researchers can upload PDFs, run OCR, synthesize topics, explore maps, and ask cited questions immediately under anonymous/legacy storage.",
        "Signing in via the sidebar avatar enables persistent Google OAuth cookies, Profile KPIs, and isolated Research History across sessions."
      ]
    },
    {
      "dot": "rose",
      "title": "Built-In Guardrails & Recovery Paths",
      "items": [
        "Pre-flight quality and security checks reject blurry camera captures (<3.0 Laplacian variance) and unsafe internal URLs before consuming AI tokens.",
        "Transient Gemini rate-limit or daily quota failures fail over automatically when auto_fallback is enabled."
      ]
    }
  ]
}
