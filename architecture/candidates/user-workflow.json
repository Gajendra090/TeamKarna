      "label": "Corpus indexed",
      "role": "main"
    },
    {
      "from": "wf_validate_extract",
      "to": "wf_blocked_guard",
      "label": "SSRF or blur",
      "role": "error",
      "variant": "dashed"
    },
    {
      "from": "wf_run_pipeline",
      "to": "wf_explore_insights",
      "label": "Insights ready",
      "role": "main"
    },
    {
      "from": "wf_run_pipeline",
      "to": "wf_quota_fallback",
      "label": "429 quota hit",
      "role": "error",
      "variant": "dashed"
    },
    {
      "from": "wf_quota_fallback",
      "to": "wf_explore_insights",
      "label": "Fallback succeeds",
      "role": "return"
    },
    {
      "from": "wf_explore_insights",
      "to": "wf_save_history",
      "label": "Persist & export",
      "role": "main"
    },
    {
      "from": "wf_blocked_guard",
      "to": "wf_select_intake",
      "label": "Fix & retry",
      "role": "return",
      "route": "return-left"
    }
