    {
      "dot": "cyan",
      "title": "SQLite Indexes & Safe Schema Migration",
      "items": [
        "idx_research_sessions_created_at (created_at DESC) & idx_research_sessions_user (user_id, created_at DESC).",
        "idx_ambiguity_history_created_at (created_at DESC) & idx_ambiguity_history_user (user_id, created_at DESC).",
        "init_history_db() runs ALTER TABLE ... ADD COLUMN user_id via _ensure_column() to preserve pre-auth legacy records under user_id='legacy_local'."
      ]
    },
    {
      "dot": "emerald",
      "title": "Security & Privacy Guarantees",
      "items": [
        "oauth_states stores SHA-256(state) alongside single-use PKCE code_verifier (deleted on consumption or after 600s TTL).",
        "auth_sessions stores SHA-256(raw_session_token); raw token lives only inside itsdangerous signed browser cookies.",
        "_sanitize_for_storage() removes API key / token / secret keys and scrubs AIza... substrings before persisting research JSON."
      ]
    },
    {
      "dot": "amber",
      "title": "Filesystem Counterpart (uploads/)",
      "items": [
        "Anonymous/legacy workspace writes PDFs into uploads/.",
        "Authenticated Google users write PDFs into uploads/user_<sha256(user_id)[:16]>/ computed by modules/auth.py:get_user_uploads_dir().",
        "Filename collisions are avoided with sanitize_filename() and SHA-256 content hashes in modules/pdf_reader.py."
      ]
    }
  ]
