# Copy this file to .env and add your credentials.
# Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the default Gemini model ID
GEMINI_MODEL=gemini-3.6-flash

# Google OAuth 2.0 credentials (from Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8501

# Optional: random secret string used to sign persistent session cookies
AUTH_COOKIE_SECRET=your_random_cookie_secret_here
